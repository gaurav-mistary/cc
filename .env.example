# Git URL of template repo (cc-templates — all self-hosted service branches)
TEMPLATES_REPO_URL=https://github.com/gaurav-mistary/cc-templates.git

# Alias → branch mapping (local path or raw GitHub URL)
CC_REGISTRY=https://raw.githubusercontent.com/gaurav-mistary/cc-templates/main/registry.json

# Legacy name used by `init` and `mix` commands (usually same as TEMPLATES_REPO_URL)
FACTORY_URL=https://github.com/gaurav-mistary/cc-templates.git

# Optional: AI merge conflict resolution during cascade (not implemented yet)
# GEMINI_API_KEY=
